# ──────────────────────────────────────────────
# Shared / Core
# ──────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=
REDIS_URL=

# ──────────────────────────────────────────────
# API Server (apps/api)
# ──────────────────────────────────────────────
API_PORT=4000
APP_URL=http://localhost:3000
INTERNAL_DOMAIN=autonoma.app
ALLOWED_ORIGINS=http://localhost:3000
AGENT_VERSION=
# Use the fake GitHub integration only for local or CAS-only smoke testing.
# A real deployment should leave this false and configure all GITHUB_APP_* values.
LOCAL_DEV=false

# Auth (Better Auth)
BETTER_AUTH_SECRET=
# Root origin of the API server only - do NOT append /v1 or any other path.
# betterAuth is mounted with basePath "/v1/auth" and appends it itself, so a
# value like https://yourdomain.com/v1 makes every auth endpoint 404.
BETTER_AUTH_URL=http://localhost:4000
# Origin advertised as the OAuth `resource` in the MCP protected-resource
# metadata. Set in prod/beta to the dedicated api.<host> origin (off CloudFront)
# that MCP clients dial. Leave unset locally - it falls back to BETTER_AUTH_URL.
MCP_RESOURCE_URL=

# Enterprise CAS - optional; set all three values or leave all three empty.
# Ruijie test environment values:
#   CAS_MANAGER_BASE_URL=https://tianshu-test.ruijie.com.cn/tianshu-manager-service
#   CAS_LOGIN_URL=https://sid.ruijie.com.cn/login
# Autonoma appends /v1/auth/exchange-cas-ticket to CAS_MANAGER_BASE_URL.
# Current hosts-based testing uses the Vite proxy as the public auth origin:
#   APP_URL=http://autonoma-test.ruijie.com.cn:3000
#   BETTER_AUTH_URL=http://autonoma-test.ruijie.com.cn:3000
#   VITE_API_URL=http://autonoma-test.ruijie.com.cn:3000
# The corresponding callback allowlisted by tianshu-manager-service is:
#   http://autonoma-test.ruijie.com.cn:3000/v1/enterprise-auth/cas/callback
# After an HTTPS reverse proxy serves UI and API on one origin, use
# https://autonoma-test.ruijie.com.cn for APP_URL, BETTER_AUTH_URL,
# VITE_API_URL, and ALLOWED_ORIGINS instead.
CAS_MANAGER_BASE_URL=https://tianshu-test.ruijie.com.cn/tianshu-manager-service
CAS_LOGIN_URL=https://sid.ruijie.com.cn/login
CAS_IDENTITY_EXCHANGE_SECRET=

# OAuth (Google) - optional; Google sign-in is only offered when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth (GitHub) - optional; GitHub sign-in is only offered when both are set.
# Create an OAuth App at https://github.com/settings/developers (Settings ->
# Developer settings -> OAuth Apps -> New OAuth App) and set its Authorization
# callback URL to http://localhost:4000/v1/auth/callback/github
# These are NOT the GITHUB_APP_* values below - that is the separate repo-facing GitHub App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth (Microsoft Entra ID) - optional; the button is only offered when both are set.
# Register an app at https://entra.microsoft.com (App registrations -> New registration)
# and add a Web redirect URI of http://localhost:4000/v1/auth/callback/microsoft
# Leave MICROSOFT_TENANT_ID out entirely to get the default "organizations": work/school
# accounts from any tenant, personal Microsoft accounts rejected. Set it only to restrict
# sign-in to a single directory.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OAuth proxy. Deployed environments share ONE registered callback URL per provider -
# production's - because a provider only redirects to URLs registered in advance, and an
# alpha's hostname is minted per PR. Every deployed environment sets the same
# OAUTH_PROXY_PRODUCTION_URL and the same OAUTH_PROXY_SECRET; production's own APP_URL
# matches the value, so it skips proxying and handles the callback for the fleet.
#
# Leave BOTH unset locally. Local dev has its own OAuth apps, and enabling this would mean
# configuring production to hand encrypted session payloads to a developer's machine.
OAUTH_PROXY_PRODUCTION_URL=
OAUTH_PROXY_SECRET=

STRIPE_ENABLED=false
# Explicitly mounts the planner's authenticated /v1/llm-proxy route. With
# Stripe enabled it uses metered OpenRouter; without Stripe it requires the
# complete OpenAI-compatible configuration in the AI section below.
LLM_PROXY_ENABLED=false

# GitHub App
# GITHUB_APP_PRIVATE_KEY is the base64-encoded PEM:  cat private-key.pem | base64
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Scenario encryption. Generate at least 32 bytes as 64 hexadecimal characters,
# for example: openssl rand -hex 32. Keep it stable after data is encrypted.
SCENARIO_ENCRYPTION_KEY=

# ──────────────────────────────────────────────
# Frontend (apps/ui)
# ──────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_INTERNAL_DOMAIN=autonoma.app
VITE_TEMPORAL_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_URL=https://sentry.autonoma.app
VITE_POSTHOG_KEY=

# ──────────────────────────────────────────────
# AI / Model APIs (packages/ai)
# ──────────────────────────────────────────────
# "builtin" uses the provider keys below. "openai-compatible" routes all
# web/mobile execution model slots through one OpenAI Chat Completions endpoint.
AI_PROVIDER=builtin

# Built-in provider credentials
GEMINI_API_KEY=
GROQ_KEY=
OPENROUTER_API_KEY=

# OpenAI-compatible provider. The base URL must include the API prefix, usually /v1.
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
# Optional per-capability overrides; each falls back to AI_COMPATIBLE_MODEL.
AI_COMPATIBLE_FAST_VISUAL_MODEL=
AI_COMPATIBLE_SMART_VISUAL_MODEL=
AI_COMPATIBLE_FAST_TEXT_MODEL=
AI_COMPATIBLE_POINTER_MODEL=

# ──────────────────────────────────────────────
# Storage / S3 (packages/storage)
# ──────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
# Optional S3-compatible endpoint. Alibaba Cloud OSS example:
# https://oss-cn-hangzhou.aliyuncs.com
S3_ENDPOINT=
# Keep false for AWS S3 and Alibaba Cloud OSS virtual-host addressing.
# Set true for local providers such as MinIO or MiniStack that require path-style URLs.
S3_FORCE_PATH_STYLE=false
# Alibaba Cloud OSS rejects response-content-type overrides on presigned GET URLs.
# Set false for OSS; stored uploads retain their own Content-Type metadata.
S3_RESPONSE_CONTENT_TYPE_OVERRIDE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ──────────────────────────────────────────────
# Observability (packages/logger)
# ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENV=
SENTRY_RELEASE=
DEBUG=

# ──────────────────────────────────────────────
# Analytics (server-side)
# ──────────────────────────────────────────────
POSTHOG_KEY=
POSTHOG_HOST=

# ──────────────────────────────────────────────
# Temporal (packages/workflow)
# ──────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ──────────────────────────────────────────────
# Kubernetes (packages/k8s)
# ──────────────────────────────────────────────
# The pod's own namespace, which the previewkit Job launcher reads the runner-image ConfigMap from. Any value
# works locally.
NAMESPACE=local

# ──────────────────────────────────────────────
# Email (Resend) - optional; without RESEND_API_KEY nothing is sent and the
# invite link is copyable from the Members page instead.
# ──────────────────────────────────────────────
RESEND_API_KEY=
# Default sender for transactional mail, including the onboarding email - which is
# deliberately from a person, so keep a human address here.
RESEND_FROM_EMAIL=
# Sender for organization invitations, which should come from the product rather than a
# person. Defaults to no-reply@ because nothing sets reply_to, so a reply to an invitation
# would be silently lost - the name says so instead of pretending otherwise. Any local part
# works with no DNS change: Resend verifies per domain.
RESEND_INVITES_FROM_EMAIL=

# ──────────────────────────────────────────────
# Engine - Web (packages/engine-web)
# ──────────────────────────────────────────────
HEADLESS=
REMOTE_BROWSER_URL=

# ──────────────────────────────────────────────
# Engine - Mobile (packages/engine-mobile)
# ──────────────────────────────────────────────
APPIUM_HOST=
APPIUM_PORT=
APPIUM_MJPEG_PORT=
APPIUM_SYSTEM_PORT=
APPIUM_SKIP_INSTALLATION=
DEVICE_NAME=
IOS_PLATFORM_VERSION=
ANDROID_DAEMON_HOSTS=
IOS_DAEMON_HOSTS=
SKIP_DEVICE_DATE_UPDATE=
